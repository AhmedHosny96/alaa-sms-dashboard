# Copy to .env. For local dev, keep VITE_API_BASE_URL empty and use Vite /api proxy.
VITE_API_BASE_URL=
# Optional: override local proxy target when backend is not on localhost:8050
# VITE_API_PROXY_TARGET=http://localhost:8050
VITE_PUBLIC_URL=/
VITE_ESLINT_NO_DEV_ERRORS=true
VITE_SKIP_PREFLIGHT_CHECK=true
# VITE_REACT_APP_TINYMCE_APIKEY=
# VITE_REACT_APP_GOOGLE_API_KEY=
# VITE_REACT_APP_MAP_ID=
